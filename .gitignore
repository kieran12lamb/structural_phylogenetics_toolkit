# Large PDB/CIF structure files. The 6 benchmark structures under tests/fixtures are
# the only tracked exception - they are the fixture set for tests/test_alignment.py.
*.pdb
*.cif
!tests/fixtures/structures/*.pdb

# Pipeline results are generated output and are never tracked.
results/

# Generated visualisation bundles and reports. These are rebuilt by
# `build-tree-view` / `build-alignments` and must not be committed.
interactive_tree.html
alignments_data.js
ca_*structures.js
matrices/ca_*.json

# Captured stdout from nohup'd pipeline runs
nohup.out


# Upper-case matrix aliases generated for IQ-TREE -mset (see matrices.py)
MATRICES/
